FROM python:3.11-slim

# Ensure Python output is not buffered (for real-time CloudWatch logs)
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY pyproject.toml .
COPY ecfr/ ecfr/
COPY cfr_viewer/ cfr_viewer/
COPY config.yaml .
COPY lambda/consolidator.py .

# Install Python package with additional dependencies
RUN pip install --no-cache-dir . boto3

# Run consolidator
CMD ["python", "consolidator.py"]
