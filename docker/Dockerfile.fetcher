FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY pyproject.toml .
COPY ecfr/ ecfr/
COPY config.yaml .

# Install Python package
RUN pip install --no-cache-dir .

# Enable atomic writes for containerized deployments
ENV ECFR_ATOMIC_WRITES=true

# Run fetcher
CMD ["python", "-m", "ecfr.fetcher"]
