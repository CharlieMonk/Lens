commands:
  01_mount_efs:
    command: |
      #!/bin/bash
      set -e

      EFS_ID="${EFS_FILE_SYSTEM_ID}"
      AP_ID="${EFS_ACCESS_POINT_ID}"
      MOUNT_POINT="/data"

      # Create mount point
      mkdir -p $MOUNT_POINT

      # Check if already mounted
      if mountpoint -q $MOUNT_POINT; then
        echo "EFS already mounted at $MOUNT_POINT"
        exit 0
      fi

      # Add to fstab if not present
      if ! grep -q "$EFS_ID" /etc/fstab; then
        echo "$EFS_ID:/ $MOUNT_POINT efs _netdev,tls,accesspoint=$AP_ID 0 0" >> /etc/fstab
      fi

      # Mount the filesystem
      mount -a

      echo "EFS mounted successfully at $MOUNT_POINT"
    test: test -n "${EFS_FILE_SYSTEM_ID}"
